    {
      "parameters": {
        "jsCode": "const errors = [];\n\n// ---------- Text fields ----------\n\nconst name = String($json.name ?? '').trim();\nconst description = String($json.description ?? '').trim();\n\nif (!name) {\n  errors.push(\"name is required\");\n}\n\nif (!description) {\n  errors.push(\"description is required\");\n}\n\n\n// ---------- Numeric fields ----------\n\nconst numericFields = [\n  \"industry_fit\",\n  \"sponsorship_potential\",\n  \"company_size\",\n  \"past_event_engagement\",\n  \"case_confidence\"\n];\n\nconst normalized = {\n  ...$json,\n  name,\n  description\n};\n\nfor (const field of numericFields) {\n\n  const rawValue = $json[field];\n\n  // Missing value\n  if (\n    rawValue === undefined ||\n    rawValue === null ||\n    rawValue === \"\"\n  ) {\n    errors.push(`${field} is required`);\n    continue;\n  }\n\n  // Convert string like \"8\" → number 8\n  const value = Number(rawValue);\n\n  // Not a valid number\n  if (!Number.isFinite(value)) {\n    errors.push(`${field} must be a number`);\n    continue;\n  }\n\n  // Outside allowed range\n  if (value < 1 || value > 10) {\n    errors.push(`${field} must be between 1 and 10`);\n    continue;\n  }\n\n  normalized[field] = value;\n}\n\n\n// ---------- Final result ----------\n\nreturn [{\n  json: {\n    ...normalized,\n\n    is_valid: errors.length === 0,\n\n    validation_errors: errors\n  }\n}];"
      },
