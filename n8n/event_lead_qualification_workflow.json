    {
      "parameters": {
        "jsCode": "const errors = [];\n\nconst allowedEvents = [\n  \"RAISE\",\n  \"Signal Week\",\n  \"MACHINA\",\n  \"Other\"\n];\n\n// event validation\nif (!allowedEvents.includes($json.event)) {\n  errors.push(`Invalid event: ${$json.event}`);\n}\n\n// relevance_score validation\nconst relevanceScore = Number($json.relevance_score);\n\nif (!Number.isFinite(relevanceScore)) {\n  errors.push(\"relevance_score must be a number\");\n} else if (relevanceScore < 1 || relevanceScore > 10) {\n  errors.push(\"relevance_score must be between 1 and 10\");\n}\n\n// reason validation\nconst reason = String($json.reason ?? \"\").trim();\n\nif (!reason) {\n  errors.push(\"reason is required\");\n}\n\nreturn [{\n  json: {\n    ...$json,\n    relevance_score: relevanceScore,\n    reason: reason,\n    ai_output_valid: errors.length === 0,\n    ai_output_errors: errors\n  }\n}];"
      },
